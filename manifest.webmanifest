{
  "name": "Camino A1 — Beginner Spanish",
  "short_name": "Camino A1",
  "description": "A complete CEFR A1 Spanish course you can work through offline: lessons, practice, unit quizzes, a verb trainer, and a final exam.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#f3ece0",
  "theme_color": "#f3ece0",
  "categories": ["education"],
  "icons": [
    {
      "src": "icons/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Verb trainer",
      "short_name": "Verbs",
      "url": "./#/verbs"
    },
    {
      "name": "Phrasebook",
      "short_name": "Phrases",
      "url": "./#/phrasebook"
    },
    {
      "name": "Final A1 exam",
      "short_name": "Exam",
      "url": "./#/exam"
    }
  ]
}
